{
  "name": "platform-dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0.302" },
    "ghcr.io/devcontainers/features/node:1": { "version": "24.18.0" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.13.14" },
    "ghcr.io/va-h/devcontainers-features/uv:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/go-task:1": {}
  },
  "postCreateCommand": "bash eng/bootstrap.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "charliermarsh.ruff",
        "ms-python.python",
        "task.vscode-task"
      ]
    }
  },
  "remoteUser": "vscode"
}
