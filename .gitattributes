# Normalize all text to LF in the repo; check out LF everywhere.
* text=auto eol=lf

# Explicit text types (belt and suspenders)
*.cs      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.py      text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
*.csproj  text eol=lf

# Windows-only scripts keep CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binaries: never touch, route to LFS
*.png  binary filter=lfs diff=lfs merge=lfs -text
*.jpg  binary filter=lfs diff=lfs merge=lfs -text
*.gif  binary filter=lfs diff=lfs merge=lfs -text
*.pdf  binary filter=lfs diff=lfs merge=lfs -text
*.pcap binary filter=lfs diff=lfs merge=lfs -text
*.zip  binary filter=lfs diff=lfs merge=lfs -text
